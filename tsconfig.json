{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",

    "rootDir": "./", 
    "outDir": "./dist",
    "declaration": true,
    "emitDeclarationOnly": true,

    "paths": {
      "@/*": ["./src/*"]
    },

    "types": ["jest", "node"], 

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules"]
}