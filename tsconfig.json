{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    
    /* Explicitly set rootDir to fix your error */
    "rootDir": "./src", 
    "outDir": "./dist",

    /* Modern Path Mapping (No baseUrl needed) */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Standards & Interop */
    "allowImportingTsExtensions": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/types/*.d.ts"],
  "exclude": ["node_modules"],
}